<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 抖音商城/电商的静态声明（40.7.0 设备版实测）：
         包名来自宿主 dex 里的 com.ss.android.commerce.chatbuy / com.ss.android.ecom* / com.bytedance.android.shopping
         scheme 来自宿主里的 aweme://ec_search、aweme://ecom/*、aweme://ecomcs_im/*、aweme://chat/bullet_shop_card/*
         Android 11+ 没有这些声明就看不到包与 Intent，设置页的电商开关也就无从判断商城是否安装 -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.livelite" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.ss.android.ugc.ugec" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="aweme" android:host="ec_search" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="aweme" android:host="ecom" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="aweme" android:host="ecomcs_im" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="aweme" android:host="mall" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="aweme" android:host="chat" />
        </intent>
    </queries>
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- 设置页面（模块主入口） -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xposed.doupp.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 跨进程设置读取桥（抖音进程通过 contentResolver.call 读取模块设置） -->
        <provider
            android:name=".provider.SettingsProvider"
            android:authorities="com.xposed.doupp.settings"
            android:exported="true" />

        <!-- 开机/更新自启动接收器：确保模块进程启动，创建 prefs 文件并注册 ContentProvider -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 保活前台服务：常驻以保证 ContentProvider 随时可用（绕过小米 WakePathChecker 唤醒拦截） -->
        <service
            android:name=".KeepAliveService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />

        <!-- 图标预览页（开发期映射用，非入口） -->
        <activity
            android:name=".ui.IconPreviewActivity"
            android:exported="true"
            android:label="Dou++ 图标预览" />

        <!-- LSPosed 模块声明 -->
        <!-- xposedminversion: 要求 LSPosed API 101+ (LibXposed 现代 API) -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />
        <!-- 关键：声明本模块使用 XSharedPreferences / getRemotePreferences 跨进程读取自己的 prefs。
             缺了这条，LSPosed 不会把模块的 prefs 目录重定向到它自己的镜像目录，
             getRemotePreferences() 就会永远返回空表（抖音进程里所有开关都只能读到编译期默认值）。
             有了它，抖音进程可直接远程读取模块 prefs，无需模块 App 进程常驻、也不依赖 ContentProvider。 -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
        <meta-data
            android:name="mallscope"
            android:resource="@array/mallscope" />

    </application>

</manifest>
